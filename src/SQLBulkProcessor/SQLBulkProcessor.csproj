<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SQLBulkProcessor</RootNamespace>
    <AssemblyName>SQLBulkProcessor</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>SQLBulkProcessor</PackageId>
    <Version>1.0.0</Version>
    <Authors>SQLBulkProcessor</Authors>
    <Company>SQLBulkProcessor</Company>
    <Description>High-performance bulk Insert, Update, Upsert, Delete, and Merge operations for Entity Framework Core on SQL Server, using SqlBulkCopy and MERGE.</Description>
    <PackageTags>entityframeworkcore;efcore;sqlserver;bulk;sqlbulkcopy;insert;update;upsert;delete;merge</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AdamRodriguez84/SQLBulkProcessor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SQLBulkProcessor.Tests" />
  </ItemGroup>

</Project>
